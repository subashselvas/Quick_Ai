# Server Port
PORT=3000

# Neon PostgreSQL Database Connection URL
# e.g., postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Clerk Authentication Keys (matches client publishable key)
CLERK_PUBLISHABLE_KEY=pk_test_dmFsaWQtY29icmEtNTkuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Google Gemini API Key (for AI Article, Title, and Resume Review)
GEMINI_API_KEY=your_gemini_api_key

# ClipDrop API Key (for Text-to-Image Generation)
CLIPDROP_API_KEY=your_clipdrop_api_key

# Cloudinary Credentials (for Image Storage, Background Removal, Object Removal)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
