{
  "name": "quickai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "install:all": "npm install && npm --prefix client install && npm --prefix server install",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run server",
    "start": "npm --prefix server start",
    "init-db": "npm --prefix server run init-db"
  },
  "dependencies": {
    "@clerk/express": "^2.1.25",
    "@neondatabase/serverless": "^1.1.0",
    "axios": "^1.16.1",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "form-data": "^4.0.5",
    "lodash": "^4.18.1",
    "multer": "^2.1.1",
    "openai": "^6.39.0",
    "pdf-parse": "^1.0.9"
  }
}
